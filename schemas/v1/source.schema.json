{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cli-fieldbook.invalid/schemas/v1/source",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "upstreamVersion": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "normalization": {
      "const": 1
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "scope"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "source-snapshot",
              "legacy-import"
            ]
          },
          "obtainedAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "url",
          "method",
          "obtainedAt"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "repository",
    "upstreamVersion",
    "ref",
    "commit",
    "adapter",
    "normalization",
    "profile",
    "evidence",
    "limitations"
  ],
  "additionalProperties": false
}
